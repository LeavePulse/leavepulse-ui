{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "preview", "*.ts", "*.vue"],
  // Nuxt-only runtime: it imports "#imports" and uses import.meta.client, both
  // of which exist in the consuming app's build, not in this repo's.
  "exclude": ["src/runtime"]
}
