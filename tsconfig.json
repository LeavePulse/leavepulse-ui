{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // node: the vite configs at the repo root import node: builtins.
    "types": ["vite/client", "node"],
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "preview", "*.ts", "*.vue"],
  // Nuxt-only sources: the runtime imports "#imports" and uses
  // import.meta.client, and the module imports @nuxt/kit — an OPTIONAL peer
  // that isn't installed here. All three resolve in the consuming app's build,
  // not in this repo's, so they're checked there rather than reported as
  // missing modules on every run (tsconfig.build.json excludes them too).
  "exclude": ["src/runtime", "src/nuxt.ts"]
}
