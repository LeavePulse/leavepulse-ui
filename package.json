{
  "name": "@leavepulse/ui",
  "version": "0.69.0",
  "type": "module",
  "description": "LeavePulse token-driven Vue component kit.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeavePulse/leavepulse-ui.git"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./src/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./src/index.css",
      "import": "./dist/index.js"
    },
    "./icons-all": {
      "types": "./dist/icons-all.d.ts",
      "import": "./dist/icons-all.js"
    },
    "./nuxt": "./src/nuxt.ts",
    "./css": "./src/index.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./scrollbar.css": "./src/tokens/scrollbar.css",
    "./selection.css": "./src/tokens/selection.css",
    "./canvas.css": "./src/canvas.css",
    "./package.json": "./package.json",
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/icons.ts",
    "**/icons-all.ts",
    "**/icons-all.js",
    "**/chunks/LpIcon-*.js",
    "**/chunks/icons-*.js"
  ],
  "scripts": {
    "dev": "vite",
    "gen:names": "node scripts/gen-component-names.mjs",
    "build": "node scripts/gen-component-names.mjs && node scripts/gen-kit-icons.mjs && vue-tsc --noEmit -p tsconfig.build.json && vite build --config vite.lib.config.ts && vue-tsc --declaration --emitDeclarationOnly --noEmit false -p tsconfig.build.json --outDir dist",
    "dev:dist": "vite build --watch --config vite.lib.config.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "vue-tsc --noEmit",
    "test": "bun test",
    "release": "npm version patch -m \"chore: release v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore: release v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"chore: release v%s\" && git push --follow-tags",
    "check:pack": "node scripts/check-pack.mjs",
    "gen:icons": "node scripts/gen-kit-icons.mjs",
    "gen:meta": "node scripts/gen-preview-meta.mjs"
  },
  "peerDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@iconify/vue": "^5.0.0",
    "@internationalized/date": "^3.5.0",
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "motion-v": "^2.2.0",
    "reka-ui": "^2.9.0",
    "tailwind-variants": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.112",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "motion-v": "^2.2.1",
    "reka-ui": "^2.9.10",
    "shiki": "^4.2.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "3.5.31",
    "vue-component-meta": "3.3.5",
    "vue-tsc": "^3.0.0"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "libphonenumber-js": "^1.12.0",
    "vaul-vue": "^0.4.1"
  }
}
